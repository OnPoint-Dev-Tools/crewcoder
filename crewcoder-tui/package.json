{
   "name": "@onpoint-dev-tools/crewcoder-tui",
   "version": "0.6.4",
   "private": false,
   "description": "CrewCoder custom terminal UI connected to crewcoder-agent with wired backend process bridge.",
   "license": "Apache-2.0",
   "repository": {
      "type": "git",
      "url": "git+https://github.com/OnPoint-Dev-Tools/crewcoder.git",
      "directory": "crewcoder-tui"
   },
   "bugs": "https://github.com/OnPoint-Dev-Tools/crewcoder/issues",
   "homepage": "https://github.com/OnPoint-Dev-Tools/crewcoder#readme",
   "type": "module",
   "files": [
      "dist",
      "LICENSE",
      "README.md"
   ],
   "publishConfig": {
      "access": "public",
      "provenance": true
   },
   "bin": {
      "crewcoder-tui": "./dist/cli.js"
   },
   "scripts": {
      "clean": "rm -rf dist",
      "dev": "tsx src/cli.ts",
      "build": "tsc -p tsconfig.json",
      "typecheck": "tsc -p tsconfig.json --noEmit",
      "test": "vitest run",
      "start": "node dist/cli.js"
   },
   "dependencies": {
      "zod": "^3.23.8"
   }
