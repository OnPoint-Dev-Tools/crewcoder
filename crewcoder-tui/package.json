{
   "name": "@onpoint-dev-tools/crewcoder-tui",
   "version": "0.6.5",
   "private": false,
   "description": "Legacy CrewCoder terminal UI (custom renderer). The crewcoder umbrella opens crewcoder-opentui and falls back to this UI where OpenTUI cannot run (Node.js below 26.4 or no OpenTUI native build).",
   "license": "Apache-2.0",
   "repository": {
      "type": "git",
      "url": "git+https://github.com/OnPoint-Dev-Tools/crewcoder.git",
      "directory": "crewcoder-tui"
   },
   "bugs": "https://github.com/OnPoint-Dev-Tools/crewcoder/issues",
   "homepage": "https://github.com/OnPoint-Dev-Tools/crewcoder#readme",
   "type": "module",
   "files": [
      "dist",
      "LICENSE",
      "README.md"
   ],
   "publishConfig": {
      "access": "public",
      "provenance": true
   },
   "bin": {
      "crewcoder-tui": "./dist/cli.js"
   },
   "scripts": {
      "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
      "predev": "npm run build -w @onpoint-dev-tools/crewcoder-tui-core",
      "dev": "tsx src/cli.ts",
      "prebuild": "npm run build -w @onpoint-dev-tools/crewcoder-tui-core",
      "build": "tsc -p tsconfig.json",
      "pretypecheck": "npm run build -w @onpoint-dev-tools/crewcoder-tui-core",
      "typecheck": "tsc -p tsconfig.json --noEmit",
      "pretest": "npm run build -w @onpoint-dev-tools/crewcoder-tui-core",
      "test": "vitest run",
      "start": "node dist/cli.js"
   },
   "dependencies": {
      "@onpoint-dev-tools/crewcoder-tui-core": "0.1.0",
      "zod": "^3.23.8"
   },
   "engines": {
      "node": ">=22.0.0"
   }
}
