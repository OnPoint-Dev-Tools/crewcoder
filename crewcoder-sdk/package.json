{
  "name": "@onpoint-dev-tools/crewcoder-sdk",
  "version": "0.6.0",
  "description": "Supported TypeScript SDK for embedded and remote CrewCoder agent sessions.",
  "license": "Apache-2.0",
  "type": "module",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "ai",
    "coding-agent",
    "crewcoder",
    "sdk"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "prebuild": "npm run build -w @onpoint-dev-tools/crewcoder-client && npm run clean",
    "build": "tsc -p tsconfig.build.json",
    "pretypecheck": "npm run build -w @onpoint-dev-tools/crewcoder-client",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build -w @onpoint-dev-tools/crewcoder-client",
    "test": "vitest run",
    "api:update": "npm run build && node ./scripts/check-api.cjs --update",
    "api:check": "npm run build && node ./scripts/check-api.cjs",
    "pack:check": "npm run build && node ../scripts/check-package.cjs .",
    "release:check": "npm run typecheck && npm test && npm run api:check && npm run pack:check",
    "check": "npm run typecheck && npm run test && npm run api:check"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.3.0",
    "@crewcode/crewcoder-agent": "0.6.0",
    "@onpoint-dev-tools/crewcoder-client": "0.6.0"
  }
}
