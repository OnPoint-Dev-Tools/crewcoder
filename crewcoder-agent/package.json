{
   "name": "@onpoint-dev-tools/crewcoder-agent",
   "version": "0.6.1",
   "description": "CrewCoder coding agent runtime and CLI",
   "license": "Apache-2.0",
   "repository": {
      "type": "git",
      "url": "git+https://github.com/OnPoint-Dev-Tools/crewcoder.git",
      "directory": "crewcoder-agent"
   },
   "bugs": "https://github.com/OnPoint-Dev-Tools/crewcoder/issues",
   "homepage": "https://github.com/OnPoint-Dev-Tools/crewcoder#readme",
   "type": "module",
   "types": "./dist/index.d.ts",
   "files": [
      "dist",
      "LICENSE",
      "README.md"
   ],
   "engines": {
      "node": ">=22.0.0"
   },
   "keywords": [
      "ai",
      "coding-agent",
      "crewcoder",
      "cli"
   ],
   "publishConfig": {
      "access": "public",
      "provenance": true
   },
   "exports": {
      ".": {
         "types": "./dist/index.d.ts",
         "default": "./dist/index.js"
      }
   },
   "bin": {
      "crewcoder": "./dist/cli.js",
      "cc": "./dist/cli.js",
      "crewcoder-agent": "./dist/cli.js"
   },
   "scripts": {
      "clean": "rm -rf dist",
      "prebuild": "npm run clean",
      "build": "tsc -p tsconfig.build.json",
      "build:standalone": "node ./scripts/build-standalone.cjs",
      "typecheck": "tsc -p tsconfig.json --noEmit",
      "dev": "tsx src/cli.ts",
      "test": "vitest run",
      "start": "node dist/cli.js",
      "pack:check": "npm run build && node ../scripts/check-package.cjs .",
      "release:check": "npm run typecheck && npm test && npm run pack:check",
      "check": "npm run typecheck && npm run test",
      "postbuild": "node ./scripts/ensure-bin-executable.cjs"
   },
   "dependencies": {
      "@agentclientprotocol/sdk": "^1.3.0",
      "@anthropic-ai/claude-agent-sdk": "0.3.179",
      "@openai/codex": "0.146.1",
      "commander": "^12.1.0",
      "fs-extra": "^11.2.0",
      "picocolors": "^1.0.1",
      "zod": "4.4.3"
   }
}
