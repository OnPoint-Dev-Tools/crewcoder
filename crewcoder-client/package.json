{
  "name": "@onpoint-dev-tools/crewcoder-client",
  "version": "0.6.0",
  "description": "Browser-safe TypeScript client for authenticated CrewCoder runners.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OnPoint-Dev-Tools/crewcoder.git",
    "directory": "crewcoder-client"
  },
  "bugs": "https://github.com/OnPoint-Dev-Tools/crewcoder/issues",
  "homepage": "https://github.com/OnPoint-Dev-Tools/crewcoder#readme",
  "type": "module",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": ["dist", "LICENSE", "README.md"],
  "keywords": ["ai", "coding-agent", "crewcoder", "browser", "client"],
  "publishConfig": { "access": "public", "provenance": true },
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "scripts": {
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "api:update": "npm run build && node ./scripts/check-api.cjs --update",
    "api:check": "npm run build && node ./scripts/check-api.cjs",
    "pack:check": "npm run build && node ../scripts/check-package.cjs .",
    "release:check": "npm run typecheck && npm test && npm run api:check && npm run pack:check"
  }
}
